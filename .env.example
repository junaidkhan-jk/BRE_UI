# Where the studio's API calls are proxied in development (vite.config.ts reads this at
# dev-server start, so it stays server-side and never reaches the browser).
#
# The dev server proxies /v1 to this target, so the app runs SAME-ORIGIN. Leave
# VITE_REGISTRY_URL empty: setting it makes the browser call the registry cross-origin, and the
# registry sends no CORS headers — the screen then says "Could not reach the server".
BRE_REGISTRY_URL=http://localhost:8081

# Shown in the header so nobody mistakes which environment they are authoring in.
VITE_ENV_LABEL=LOCAL

# true serves sample data and says so on every screen. Set false to use the real backend above.
VITE_USE_FIXTURES=true
