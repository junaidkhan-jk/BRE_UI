# The Backend-for-Frontend the studio talks to (TRD §13.1-13.3).
# The studio never calls the Decision API or the studio-service directly.
#
# Copy to .env.local and change. Vite only exposes variables prefixed VITE_ to
# the browser; BRE_BFF_URL is read by vite.config.ts at dev-server start, so it
# stays server-side.
BRE_BFF_URL=http://localhost:8081

# Shown in the header so nobody mistakes which environment they are authoring in.
VITE_ENV_LABEL=LOCAL
VITE_USE_FIXTURES=true
