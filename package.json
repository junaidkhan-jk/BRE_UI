{
  "name": "bre-studio-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "BRE 2.0 Rule Studio — the authoring, review and decision-trace workspace",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint src --max-warnings 0",
    "format": "prettier --write src",
    "test": "vitest run",
    "e2e": "playwright test",
    "e2e:a11y": "playwright test e2e/accessibility.spec.ts"
  },
  "dependencies": {
    "monaco-editor": "^0.57.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.9.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.64.0",
    "@types/node": "^22.18.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.4",
    "eslint": "^9.37.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.0",
    "vite": "^7.1.9",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=20.19"
  }
}
